{
  "name": "f1-app",
  "version": "1.1.0",
  "description": "F1 Pit Wall Command Center desktop app with live timing, telemetry, live streams, and automatic updates",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "electron main.dev.js",
    "electron:build": "npm run build && electron-builder",
    "release": "electron-builder --win --x64 --publish always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "f1",
    "formula1",
    "telemetry",
    "live-timing",
    "f1tv",
    "electron"
  ],
  "author": "ko24601",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.6.15",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.f1app.desktop",
    "productName": "F1 App",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ko24601",
        "repo": "APPO",
        "private": false
      }
    ]
  }
}
