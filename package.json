{
  "name": "f1-app",
  "version": "1.0.0",
  "description": "F1 themed desktop app with driver tracker, weather and track data",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder",
    "release": "electron-builder --win --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.f1app.desktop",
    "productName": "F1 App",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ko24601",
        "repo": "APPO",
        "private": false
      }
    ]
  }
